# Backend endpoints for the Expo app.
#
# Copy this file to `.env` and point it at the machine running the Go services.
# Every value is public: EXPO_PUBLIC_* variables are inlined into the JS bundle
# at build time, so no secret belongs here.
#
# Defaults when a variable is unset (see src/lib/env.ts):
#   Android emulator -> http://10.0.2.2:<port>   (10.0.2.2 is the host loopback)
#   iOS simulator    -> http://localhost:<port>
#
# A physical phone can reach neither: use the development machine's LAN address,
# e.g. EXPO_PUBLIC_AUTH_URL=http://192.168.1.20:50051, and make sure the phone is
# on the same network.

# Auth service — register, login, refresh, logout, current user.
EXPO_PUBLIC_AUTH_URL=http://192.168.1.20:50051

# Upload service — upload sessions, block writes, edit commits.
EXPO_PUBLIC_UPLOAD_URL=http://192.168.1.20:50052

# Metadata service — files, folders, previews, download tickets.
EXPO_PUBLIC_METADATA_URL=http://192.168.1.20:50053
